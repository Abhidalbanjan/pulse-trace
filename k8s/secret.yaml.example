apiVersion: v1
kind: Secret
metadata:
  name: pulsetrace-secrets
  namespace: pulsetrace
type: Opaque
# TEMPLATE — copy to k8s/secret.yaml and fill in real values for local/dev use.
#   cp k8s/secret.yaml.example k8s/secret.yaml
# k8s/secret.yaml is git-ignored so real secrets never land in version control.
#
# For any production or shared deployment DO NOT hand-manage this file. Sync it
# from a real secret backend instead — see k8s/README.md and
# k8s/externalsecret.yaml.example (External Secrets Operator).
stringData:
  POSTGRES_PASSWORD: "CHANGE_ME"
  DATABASE_URL: "postgres://pulsetrace:CHANGE_ME@postgres:5432/pulsetrace?sslmode=disable"
  RABBITMQ_URL: "amqp://pulsetrace:CHANGE_ME@rabbitmq:5672/"
  # Causal AI — set to an Anthropic API key to enable LLM-backed root-cause
  # analysis. Leave empty to fall back to the deterministic rule-based analyzer.
  ANTHROPIC_API_KEY: ""
  # REQUIRED — do not leave unset in any real deployment. gateway-service
  # generates a random per-process secret with a loud warning if this is empty,
  # which invalidates every session on every pod restart.
  #   openssl rand -base64 32
  JWT_SECRET: "CHANGE_ME_generate_a_real_random_secret"
  CLICKHOUSE_PASSWORD: "CHANGE_ME"
  NEO4J_PASSWORD: "CHANGE_ME"
  # Shared HMAC secret between correlation-service and topology-service for
  # authenticating automated playbook execution requests — must be identical on
  # both. Change together, not independently.
  PLAYBOOK_HMAC_SECRET: "CHANGE_ME_shared_playbook_hmac_secret"
  # Multi-tenancy: when "true", telemetry ingestion (/v1/traces, /v1/metrics,
  # /v1/logs, /api/v1/logs) is REJECTED unless the caller presents a valid
  # per-tenant ingestion key (Authorization: Bearer <key>). Mint keys via
  # POST /api/v1/admin/ingestion-keys. Leave "false" only for a single-tenant
  # local stack; set "true" for any multi-tenant deployment so tenant identity
  # can never be spoofed via a request header.
  REQUIRE_INGESTION_KEY: "false"
  # Optional SSO (Google OIDC). Leave blank to disable SSO.
  GOOGLE_CLIENT_ID: ""
  GOOGLE_CLIENT_SECRET: ""
  # Billing. BILLING_PROVIDER is "manual" (enterprise/on-prem; operators set plans
  # via POST /api/v1/admin/tenant/plan) or "stripe" (self-serve SaaS). Stripe needs
  # the keys below plus a Price id per paid plan. PUBLIC_BASE_URL is where Stripe
  # redirects back after checkout (your frontend origin).
  BILLING_PROVIDER: "manual"
  PUBLIC_BASE_URL: "http://localhost:3000"
  STRIPE_SECRET_KEY: ""
  STRIPE_WEBHOOK_SECRET: ""
  STRIPE_PRICE_STANDARD: ""
  STRIPE_PRICE_PREMIUM: ""
  # Optional notification channels — leave blank to skip that channel
  # (the always-on log channel fires regardless; see notification_worker.go).
  SLACK_WEBHOOK_URL: ""
  SMTP_HOST: ""
  SMTP_USERNAME: ""
  SMTP_PASSWORD: ""
