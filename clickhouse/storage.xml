<clickhouse>
    <storage_configuration>
        <disks>
            <!-- Remove default conflicting disks from image's main config.xml -->
            <s3 remove="1" />
            <blob_storage_disk remove="1" />
            <data remove="1" />

            <!-- AWS S3 / MinIO Cold Storage Tier -->
            <s3_cold>
                <type>s3</type>
                <endpoint from_env="AWS_S3_ENDPOINT" />
                <access_key_id from_env="AWS_ACCESS_KEY_ID" />
                <secret_access_key from_env="AWS_SECRET_ACCESS_KEY" />
                <skip_access_check>1</skip_access_check>
            </s3_cold>

            <!-- Azure Blob Cold Storage Tier -->
            <azure_cold>
                <type>azure_blob_storage</type>
                <storage_account_url from_env="AZURE_STORAGE_ACCOUNT_URL" />
                <container_name from_env="AZURE_CONTAINER_NAME" />
                <account_name from_env="AZURE_ACCOUNT_NAME" />
                <account_key from_env="AZURE_ACCOUNT_KEY" />
                <path from_env="AZURE_BLOB_PATH" />
                <skip_access_check>1</skip_access_check>
            </azure_cold>

            <!-- Google Cloud Storage (GCP/GCS) Cold Storage Tier -->
            <gcp_cold>
                <type>s3</type>
                <!-- ClickHouse loads these values from GCP_* environment variables -->
                <endpoint from_env="GCP_GCS_ENDPOINT" />
                <access_key_id from_env="GCP_ACCESS_KEY_ID" />
                <secret_access_key from_env="GCP_SECRET_ACCESS_KEY" />
                <skip_access_check>1</skip_access_check>
            </gcp_cold>
        </disks>
        
        <policies>
            <!-- Remove default conflicting policy from image's main config.xml -->
            <all remove="1" />

            <tiered>
                <volumes>
                    <hot>
                        <disk>default</disk>
                    </hot>
                    <cold>
                        <!-- ClickHouse allows moving data parts to any of these configured cold storage disks -->
                        <disk>s3_cold</disk>
                        <disk>azure_cold</disk>
                        <disk>gcp_cold</disk>
                    </cold>
                </volumes>
            </tiered>
        </policies>
    </storage_configuration>
</clickhouse>
