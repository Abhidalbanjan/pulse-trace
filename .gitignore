# IDE and system files
.idea/
.vscode/
.antigravitycli/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Environment configuration
.env
.env.*
!.env.example

# ClickHouse troubleshooting logs and config exports
*_error.log
clickhouse_config.xml
docker_related_config.xml

# Go binaries and build directories
/bin/
*.exe
*.test
*.out
*-service/gateway-service
*-service/log-service
*-service/alert-service
*-service/correlation-service
*-service/notification-service
*-service/topology-service
*-service/vendor/
/gateway-service/vendor/
/log-service/vendor/
/alert-service/vendor/
/correlation-service/vendor/
/notification-service/vendor/
/topology-service/vendor/

# Orphaned `go work vendor` snapshot — no Dockerfile, Makefile, or script in
# this repo builds from it (gateway-service uses its own /gateway-service/vendor/
# instead, see above). Removed from tracking; keep it from coming back.
/vendor/

# Tool config/output, not project source
/.claude/
/graphify-out/

# Load-harness run artifacts (F0.2). The published baseline lives in
# PERF_BASELINE.md (committed); these are the raw per-run JSON that feeds it.
/scripts/load/summary.json
/scripts/load/infra-metrics.json

# Real k8s secrets are never committed — deployments edit this in place, so a
# committed value leaks permanently into git history. Copy k8s/secret.yaml.example
# to k8s/secret.yaml locally, or sync via External Secrets (k8s/externalsecret.yaml.example).
/k8s/secret.yaml

# Compiled bench tool (the binary is named after its directory)
/corpus
scripts/bench/corpus/corpus

# Bench run artifact (regenerated every run)
scripts/bench/.last-run.json
scripts/bench/.footprint*.json

# The generated corpus. Byte-reproducible from `corpus --seed 42`, so it is
# cheaper to regenerate than to carry: the 2 GiB run is 2,147,484,283 bytes and
# the documented default is 10 GiB.
corpus.ndjson
*.ndjson
