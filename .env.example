# PulseTrace — Environment Variables (example)
#
# Copy this file to .env and fill in real values before running anywhere
# that isn't your own laptop. Nothing in this file should ever contain a
# real secret — .env (the actual file you create) should stay out of git.

# ── Auth ──────────────────────────────────────────────────────────────────
# Required in any shared/staging/production deployment. If unset, gateway-service
# generates a random per-process secret at startup (logged as a WARNING) so local
# dev still works, but every restart invalidates existing sessions.
JWT_SECRET=

# Google SSO (optional). Leave blank to disable SSO entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Encryption at rest (fail-closed) ──────────────────────────────────────
# Both are AES-256 keys: 32 bytes, supplied as hex-64 or base64. Generate with:
#   openssl rand -hex 32
#
# These fail *closed* — the features refuse to store plaintext rather than
# degrade quietly:
#   CHANNEL_ENCRYPTION_KEY  notification-service encrypts alert-channel secrets
#                           (Slack/PagerDuty/Opsgenie/webhook credentials).
#                           Unset → channel creation with secrets is rejected.
#   MFA_ENCRYPTION_KEY      gateway-service encrypts TOTP seeds at rest.
#                           Unset → MFA enrolment is unavailable.
CHANNEL_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY=

# ── Internal service-to-service secret ───────────────────────────────────
# Shared HMAC secret used between correlation-service and topology-service to
# authenticate automated playbook execution requests. docker-compose.yml ships
# a dev-only default so both services agree out of the box locally — override
# this with a real random value for any non-local deployment.
PLAYBOOK_HMAC_SECRET=

# ── Self-healing / auto-remediation ───────────────────────────────────────
# Governs whether PulseTrace may change your running infrastructure on its own
# when causal AI proposes a recovery playbook. Read by correlation-service (the
# decision), topology-service and action-service (the execution) — each service
# enforces it independently, so an on-prem agent set to dry-run stays dry-run
# regardless of what the control plane asks for.
#
#   off      Never execute; playbooks are recorded as suggestions only.
#   dry-run  Plan and record exactly what would run; change nothing. Start here.
#   manual   Require a human to approve each remediation. DEFAULT.
#   auto     Execute without a human when confidence clears the threshold.
#            This was the old unconditional behaviour — now an explicit opt-in.
#
# An unrecognized value is rejected and the service falls back to "manual",
# rather than failing open.
REMEDIATION_MODE=

# Who may APPROVE a remediation, per action risk. Low-risk actions (restart,
# recycle) can be approved by anyone the gateway RBAC lets reach the endpoint.
# High-risk actions (scale, rollback, delete, drain, failover — and anything we
# can't classify) require an elevated role: "admin" always, plus this optional
# comma-separated list. Empty = only admin may approve high-risk remediation.
REMEDIATION_ELEVATED_ROLES=

# Causal-analysis confidence below which a playbook is never proposed for
# execution or approval (it stays a suggestion). Range 0–1, default 0.70.
REMEDIATION_CONFIDENCE_THRESHOLD=

# ── ClickHouse ────────────────────────────────────────────────────────────
# Must match the credentials the clickhouse container itself is provisioned with.
CLICKHOUSE_USER=pulsetrace
CLICKHOUSE_PASSWORD=

# ── Notification delivery (Phase 0) ──────────────────────────────────────
# Slack incoming webhook URL. Leave blank to disable Slack notifications.
SLACK_WEBHOOK_URL=

# SMTP for email notifications. Leave SMTP_HOST blank to disable email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@pulsetrace.local
SMTP_TO=

# PagerDuty Events API v2. Set to a service's integration ("routing") key to
# page on-call; leave blank to disable. Notifications dedup on the incident ID,
# so an auto-resolve (below) closes the exact alert it opened.
PAGERDUTY_ROUTING_KEY=

# Incident auto-resolve (correlation-service). An OPEN incident with no new alert
# for AUTO_RESOLVE_QUIET is treated as recovered: it's marked RESOLVED and a
# resolve notification fires, which auto-closes the PagerDuty/Opsgenie alert.
# Set AUTO_RESOLVE_QUIET=0 to disable. Values are Go durations (e.g. 10m, 30s).
AUTO_RESOLVE_QUIET=10m
AUTO_RESOLVE_INTERVAL=1m

# Opsgenie Alerts API. Set OPSGENIE_API_KEY to enable; leave blank to disable.
# OPSGENIE_API_URL only needs changing for the EU region
# (https://api.eu.opsgenie.com/v2/alerts).
OPSGENIE_API_KEY=
OPSGENIE_API_URL=

# Generic outbound webhook. Set WEBHOOK_URL to POST each incident as JSON to
# your own endpoint. When WEBHOOK_SECRET is also set, requests carry an
# X-PulseTrace-Signature: sha256=<hmac> header so the receiver can verify them.
WEBHOOK_URL=
WEBHOOK_SECRET=

# ── OTLP/gRPC ingestion receiver (:4317) ──────────────────────────────────
# The gateway terminates OTLP/gRPC in-process and authenticates each export
# with its per-tenant ingestion key. Over plaintext that key crosses the wire
# in the clear, so serve the receiver over TLS in any environment where :4317
# is exposed and not already fronted by a TLS-terminating LB/ingress.
#
# Leave both blank for plaintext (local/dev). Setting only one is a hard error.
OTLP_TLS_CERT_FILE=
OTLP_TLS_KEY_FILE=
# Optional: set a client CA to require mTLS — clients must then present a cert
# signed by this CA, a transport-level auth factor on top of the ingestion key.
OTLP_TLS_CLIENT_CA_FILE=

# ── LLM / Causal AI (optional) ────────────────────────────────────────────
# If none of these are set, correlation-service falls back to a deterministic
# rule-based analyzer — the platform runs fine without an LLM key.
#
# LLM_PROVIDERS is the preferred form: an ordered failover chain of
# "provider[:model]" entries. The first provider that answers wins; a provider
# that errors is skipped for a cooldown window (30s, doubling) so an outage or
# rate limit at the primary degrades causal AI instead of disabling it.
# Providers whose credentials are missing are skipped at startup, so it is
# safe to list more than you have keys for.
# Supported providers: anthropic, openai, googleai, ollama.
#   LLM_PROVIDERS=anthropic:claude-sonnet-4-5,openai:gpt-4o-mini,ollama:llama3
LLM_PROVIDERS=

# Legacy single-provider form. Ignored when LLM_PROVIDERS is set.
LLM_PROVIDER=
LLM_MODEL=

# Endpoint overrides. Prefer the provider-specific vars — LLM_ENDPOINT is
# shared across providers and is ambiguous once a chain is configured (a value
# meant for a local Ollama daemon would also be used as OpenAI's base URL).
OPENAI_BASE_URL=
OLLAMA_ENDPOINT=
LLM_ENDPOINT=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
