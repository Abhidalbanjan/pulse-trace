# Production secret delivery via the External Secrets Operator (ESO).
#
# Instead of a hand-edited Secret checked into git, ESO pulls values from a real
# secret backend (HashiCorp Vault, AWS Secrets Manager, GCP Secret Manager, Azure
# Key Vault, ...) and materializes the SAME `pulsetrace-secrets` Secret every
# workload already consumes — so nothing else in k8s/ has to change.
#
# This template keeps both deployment models open:
#   - SaaS:       point SecretStore at your cloud provider's secret manager.
#   - Enterprise: point SecretStore at the customer's in-cluster Vault.
#
# Prereqs: install ESO (https://external-secrets.io) and create the SecretStore
# below with credentials for your chosen backend. Then `kubectl apply -f` this
# file. Do NOT also apply k8s/secret.yaml — ESO owns the Secret.
---
apiVersion: external-secrets.io/v1beta1
kind: SecretStore
metadata:
  name: pulsetrace-store
  namespace: pulsetrace
spec:
  provider:
    # EXAMPLE: HashiCorp Vault. Swap `provider` for aws/gcpsm/azurekv as needed —
    # see https://external-secrets.io/latest/provider/ for each backend's schema.
    vault:
      server: "https://vault.example.internal:8200"
      path: "secret"
      version: "v2"
      auth:
        kubernetes:
          mountPath: "kubernetes"
          role: "pulsetrace"
---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: pulsetrace-secrets
  namespace: pulsetrace
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: pulsetrace-store
    kind: SecretStore
  target:
    # Materializes as the same Secret name the Deployments reference today.
    name: pulsetrace-secrets
    creationPolicy: Owner
  # Each key maps a Secret key to a property in the backend. `remoteRef.key` is
  # the backend path/secret name; `property` is the field within it.
  data:
    - secretKey: POSTGRES_PASSWORD
      remoteRef: { key: pulsetrace/db, property: postgres_password }
    - secretKey: DATABASE_URL
      remoteRef: { key: pulsetrace/db, property: database_url }
    - secretKey: RABBITMQ_URL
      remoteRef: { key: pulsetrace/mq, property: rabbitmq_url }
    - secretKey: JWT_SECRET
      remoteRef: { key: pulsetrace/auth, property: jwt_secret }
    - secretKey: CLICKHOUSE_PASSWORD
      remoteRef: { key: pulsetrace/db, property: clickhouse_password }
    - secretKey: NEO4J_PASSWORD
      remoteRef: { key: pulsetrace/db, property: neo4j_password }
    - secretKey: PLAYBOOK_HMAC_SECRET
      remoteRef: { key: pulsetrace/auth, property: playbook_hmac_secret }
    - secretKey: REQUIRE_INGESTION_KEY
      remoteRef: { key: pulsetrace/config, property: require_ingestion_key }
    - secretKey: ANTHROPIC_API_KEY
      remoteRef: { key: pulsetrace/ai, property: anthropic_api_key }
    - secretKey: GOOGLE_CLIENT_ID
      remoteRef: { key: pulsetrace/sso, property: google_client_id }
    - secretKey: GOOGLE_CLIENT_SECRET
      remoteRef: { key: pulsetrace/sso, property: google_client_secret }
    - secretKey: SLACK_WEBHOOK_URL
      remoteRef: { key: pulsetrace/notify, property: slack_webhook_url }
    - secretKey: SMTP_HOST
      remoteRef: { key: pulsetrace/notify, property: smtp_host }
    - secretKey: SMTP_USERNAME
      remoteRef: { key: pulsetrace/notify, property: smtp_username }
    - secretKey: SMTP_PASSWORD
      remoteRef: { key: pulsetrace/notify, property: smtp_password }
    - secretKey: PAGERDUTY_ROUTING_KEY
      remoteRef: { key: pulsetrace/notify, property: pagerduty_routing_key }
    - secretKey: OPSGENIE_API_KEY
      remoteRef: { key: pulsetrace/notify, property: opsgenie_api_key }
    - secretKey: WEBHOOK_URL
      remoteRef: { key: pulsetrace/notify, property: webhook_url }
    - secretKey: WEBHOOK_SECRET
      remoteRef: { key: pulsetrace/notify, property: webhook_secret }
